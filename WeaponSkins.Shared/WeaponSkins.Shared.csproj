<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputPath>$(MSBuildThisFileDirectory)../build/exports/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep in lockstep with WeaponSkins.csproj so both projects build against one framework version. -->
    <PackageReference Include="SwiftlyS2.CS2" Version="1.4.2" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
